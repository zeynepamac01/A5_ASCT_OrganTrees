{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "description": "An example of a radial layout for a node-link diagram of hierarchical data.",
    "width": 910,
    "height": 500,
    "padding": 0,
    "autosize": "none",
    "signals": [
        {
            "name": "xShift",
            "value": 80
        },
        {
            "name": "labels",
            "value": true,
            "bind": {
                "input": "checkbox"
            }
        },
        {
            "name": "layout",
            "value": "cluster",
            "bind": {
                "input": "radio",
                "options": [
                    "tidy",
                    "cluster"
                ]
            }
        },
        {
            "name": "links",
            "value": "diagonal",
            "bind": {
                "input": "select",
                "options": [
                    "line",
                    "curve",
                    "diagonal",
                    "orthogonal"
                ]
            }
        }
    ],
