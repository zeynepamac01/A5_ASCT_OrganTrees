{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "description": "An example of a radial layout for a node-link diagram of hierarchical data.",
    "width": 800,
    "height": 500,
    "padding": 0,
    "autosize": "none",
    "signals": [
        {
            "name": "xShift",
            "value": 80
        },
        {
            "name": "labels",
            "value": true,
            "bind": {
                "input": "checkbox"
            }
        },
        {
            "name": "layout",
            "value": "cluster",
            "bind": {
                "input": "radio",
                "options": [
                    "tidy",
                    "cluster"
                ]
            }
        },
        {
            "name": "links",
            "value": "diagonal",
            "bind": {
                "input": "select",
                "options": [
                    "line",
                    "curve",
                    "diagonal",
                    "orthogonal"
                ]
            }
        }
    ],
    "data": [
        {
            "name": "tree",
            "values": [
                {
                    "id": 0,
                    "name": "Body",
                    "type": "AS",
                    "ontology_id": "UBERON:0013702",
                    "id_from_ontology_id": "UBERON:0013702",
                    "color": "#984ea0",
                    "organ": "body",
                    "show_label": 1,
                    "label_text": "Body",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9201,
                    "name": "Prostate gland",
                    "parent": 0,
                    "type": "AS",
                    "ontology_id": "UBERON:0002367",
                    "id_from_ontology_id": "UBERON:0002367",
                    "color": "#984ea0",
                    "organ": "prostate",
                    "show_label": 1,
                    "label_text": "Prostate gland",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9202,
                    "name": "Prostate epithelium",
                    "parent": 9201,
                    "type": "AS",
                    "ontology_id": "UBERON:0000428",
                    "id_from_ontology_id": "UBERON:0000428",
                    "color": "#984ea0",
                    "organ": "prostate",
                    "show_label": 1,
                    "label_text": "Prostate epithelium",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9203,
                    "name": "Prostate glandular acinus",
                    "parent": 9202,
                    "type": "AS",
                    "ontology_id": "UBERON:0004179",
                    "id_from_ontology_id": "UBERON:0004179",
                    "color": "#C62828",
                    "organ": "prostate",
                    "show_label": 1,
                    "label_text": "Prostate glandular acinus",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9204,
                    "name": "Luminal cell of prostate epithelium",
                    "parent": 9203,
                    "type": "CT",
                    "ontology_id": "CL:0002340",
                    "id_from_ontology_id": "CL:0002340",
                    "color": "#C62828",
                    "organ": "prostate",
                    "show_label": 1,
                    "label_text": "Luminal cell of the prostate epithelium",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9205,
                    "name": "Basal cell of prostate epithelium",
                    "parent": 9203,
                    "type": "CT",
                    "ontology_id": "CL:0002341",
                    "id_from_ontology_id": "CL:0002341",
                    "color": "#ff7f00",
                    "organ": "prostate",
                    "show_label": 0,
                    "label_text": "",
                    "label_dx": 8.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9230,
                    "name": "Prostatic urethra",
                    "parent": 9201,
                    "type": "AS",
                    "ontology_id": "UBERON:0001335",
                    "id_from_ontology_id": "UBERON:0001335",
                    "color": "#C62828",
                    "organ": "prostate",
                    "show_label": 1,
                    "label_text": "Prostatic urethra",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                },
                {
                    "id": 9234,
                    "name": "Hillock cell of prostatic urethral epithelium",
                    "parent": 9230,
                    "type": "CT",
                    "ontology_id": "CL:0017011",
                    "id_from_ontology_id": "CL:0017011",
                    "color": "#C62828",
                    "organ": "prostate",
                    "show_label": 1,
                    "label_text": "Hillock cell of the prostatic urethral epithelium",
                    "label_dx": 7.0,
                    "label_dy": -7,
                    "label_align": "left",
                    "label_baseline": "bottom"
                }
            ],
            "transform": [
                {
                    "type": "stratify",
                    "key": "id",
                    "parentKey": "parent"
                },
                {
                    "type": "tree",
                    "method": {
                        "signal": "layout"
                    },
                    "size": [
                        240,
                        400
                    ],
                    "as": [
                        "x",
                        "y",
                        "depth",
                        "children"
                    ]
                },
                {
                    "type": "formula",
                    "expr": "datum.y + 50",
                    "as": "x_draw"
                },
                {
                    "type": "formula",
                    "expr": "datum.x + 220",
                    "as": "y_draw"
                }
            ]
        },
        {
            "name": "links",
            "source": "tree",
            "transform": [
                {
                    "type": "treelinks"
                },
                {
                    "type": "linkpath",
                    "shape": {
                        "signal": "links"
                    },
                    "orient": "horizontal",
                    "sourceX": "source.x_draw",
                    "sourceY": "source.y_draw",
                    "targetX": "target.x_draw",
                    "targetY": "target.y_draw"
                }
            ]
        }
    ],
    "marks": [
        {
            "type": "path",
            "from": {
                "data": "links"
            },
            "encode": {
                "update": {
                    "path": {
                        "field": "path"
                    },
                    "stroke": {
                        "value": "#ccc"
                    },
                    "opacity": {
                        "value": 0.8
                    },
                    "strokeWidth": {
                        "value": 1.1
                    }
                }
            }
        },
        {
            "type": "symbol",
            "from": {
                "data": "tree"
            },
            "encode": {
                "enter": {
                    "size": {
                        "value": 45
                    },
                    "stroke": {
                        "value": "#fff"
                    },
                    "strokeWidth": {
                        "value": 0.5
                    }
                },
                "update": {
                    "x": {
                        "field": "x_draw"
                    },
                    "y": {
                        "field": "y_draw"
                    },
                    "fill": {
                        "field": "color"
                    },
                    "opacity": {
                        "value": 0.7
                    }
                }
            }
        },
        {
            "type": "text",
            "from": {
                "data": "tree"
            },
            "encode": {
                "enter": {
                    "text": {
                        "field": "label_text"
                    },
                    "fontSize": {
                        "value": 12
                    },
                    "font": {
                        "value": "BentonSans"
                    },
                    "baseline": {
                        "value": "middle"
                    }
                },
                "update": {
                    "x": {
                        "field": "x_draw"
                    },
                    "y": {
                        "field": "y_draw"
                    },
                    "align": {
                        "field": "label_align"
                    },
                    "opacity": {
                        "signal": "datum.label_text != '' ? 1 : 0"
                    },
                    "dx": {
                        "field": "label_dx"
                    },
                    "dy": {
                        "field": "label_dy"
                    },
                    "baseline": {
                        "field": "label_baseline"
                    },
                    "angle": {
                        "value": -30
                    }
                }
            }
        }
    ],
    "config": {}
}