            "transform": [
                {
                    "type": "stratify",
                    "key": "id",
                    "parentKey": "parent"
                },
                {
                    "type": "tree",
                    "method": {
                        "signal": "layout"
                    },
                    "size": [
                        570,
                        500
                    ],
                    "as": [
                        "x",
                        "y",
                        "depth",
                        "children"
                    ]
                },
                {
                    "type": "formula",
                    "expr": "datum.y + 50",
                    "as": "x_draw"
                },
                {
                    "type": "formula",
                    "expr": "datum.x + 220",
                    "as": "y_draw"
                }
            ]
        },
        {
            "name": "links",
            "source": "tree",
            "transform": [
                {
                    "type": "treelinks"
                },
                {
                    "type": "linkpath",
                    "shape": {
                        "signal": "links"
                    },
                    "orient": "horizontal",
                    "sourceX": "source.x_draw",
                    "sourceY": "source.y_draw",
                    "targetX": "target.x_draw",
                    "targetY": "target.y_draw"
                }
            ]
        }
    ],
    "marks": [
        {
            "type": "path",
            "from": {
                "data": "links"
            },
            "encode": {
                "update": {
                    "path": {
                        "field": "path"
                    },
                    "stroke": {
                        "value": "#ccc"
                    },
                    "opacity": {
                        "value": 0.8
                    },
                    "strokeWidth": {
                        "value": 1.1
                    }
                }
            }
        },
        {
            "type": "symbol",
            "from": {
                "data": "tree"
            },
            "encode": {
                "enter": {
                    "size": {
                        "value": 45
                    },
                    "stroke": {
                        "value": "#fff"
                    },
                    "strokeWidth": {
                        "value": 0.5
                    }
                },
                "update": {
                    "x": {
                        "field": "x_draw"
                    },
                    "y": {
                        "field": "y_draw"
                    },
                    "fill": {
                        "field": "color"
                    },
                    "opacity": {
                        "value": 0.7
                    }
                }
            }
        },
        {
            "type": "text",
            "from": {
                "data": "tree"
            },
            "encode": {
                "enter": {
                    "text": {
                        "field": "label_text"
                    },
                    "fontSize": {
                        "value": 12
                    },
                    "font": {
                        "value": "BentonSans"
                    },
                    "baseline": {
                        "value": "middle"
                    }
                },
                "update": {
                    "x": {
                        "field": "x_draw"
                    },
                    "y": {
                        "field": "y_draw"
                    },
                    "align": {
                        "field": "label_align"
                    },
                    "opacity": {
                        "signal": "datum.label_text != '' ? 1 : 0"
                    },
                    "dx": {
                        "field": "label_dx"
                    },
                    "dy": {
                        "field": "label_dy"
                    },
                    "baseline": {
                        "field": "label_baseline"
                    },
                    "angle": {
                        "value": -30
                    }
                }
            }
        }
    ],
    "config": {}
}